# Copy to .env.local and adjust. .env.local is gitignored.
#
# Base URL of the Monero API, trailing slash included.
# If this is missing the app falls back to the PRODUCTION API, so set it
# deliberately when working against anything else.
NEXT_PUBLIC_API_URL=https://api.moneroget.com/api/

# Error tracking. Optional in development.
# NEXT_PUBLIC_BUGSNAG_API_KEY=
